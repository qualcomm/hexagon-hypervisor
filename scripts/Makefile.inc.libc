# Dear emacs, this is a -*- Makefile -*-
#
# C library selection for guest programs (booter's helpers, test guests).
#
# With PICOLIBC=1 guests are built against the toolchain's Picolibc H2 sysroot,
# mirroring the toolchain's bin/h2-picolibc.cfg.  Otherwise they use the default
# (Dinkumware) H2 runtime via -moslib=h2.
#
#   OSLIB_CFLAGS    compile flags selecting the libc headers
#   OSLIB_LDFLAGS   link flags selecting the libc, runtime and startup files
#   GUEST_LDSCRIPT  guest-only link flags (Picolibc: locks + linker template)
#   STANDALONE_LIBC_CFLAGS / STANDALONE_LIBC_LDFLAGS
#                   bare-metal (no H2 underneath) libc selection for
#                   STANDALONE tests; empty for Dinkumware, whose driver
#                   default is already standalone

ifndef MAKE_INC_LIBC
MAKE_INC_LIBC := 1

ifeq ($(PICOLIBC),1)
OSLIB_CFLAGS  := --target=hexagon-h2-elf --cstdlib=picolibc
OSLIB_LDFLAGS := --target=hexagon-h2-elf --cstdlib=picolibc
# The template lives next to the compiler: <tools>/bin/../templates/...
# Resolve the compiler through TOOLCHAIN_BIN when set; make < 4.4 does not pass
# an exported PATH to $(shell), so 'which' alone may find the wrong compiler.
PICOLIBC_CC_PATH := $(if $(TOOLCHAIN_BIN),$(TOOLCHAIN_BIN)/$(CC),$(shell which $(CC)))
PICOLIBC_LCS := $(abspath $(dir $(PICOLIBC_CC_PATH))/../templates/staticExecutable/static-executable-h2-picolibc.lcs.template)
# Retargetable locks: liblocks.a has the real lock code.  Every Picolibc link of
# a guest, kernel-space or STANDALONE test takes it, before libh2 (it calls
# pthread_mutex_lock) and before the implicit libc.a.  The --undefined forces its
# member in, so libc.a's member (strong no-op locks) is never pulled.  Linking it
# also links the H2 pthread runtime, whose main-thread TLS must follow the linker's
# TLS layout (pthread_thread.ref.c).  The bootvm images take it as well, through
# BOOTVM_LOCKS_LDFLAGS: booter's bootvm links no -moslib=h2, so it also needs -lh2.
LIBC_LOCKS_LDFLAGS := -Wl,--undefined=__retarget_lock_init -Wl,-l:liblocks.a
BOOTVM_LOCKS_LDFLAGS := $(LIBC_LOCKS_LDFLAGS) -lh2
GUEST_LDSCRIPT := $(LIBC_LOCKS_LDFLAGS) -Wl,--script=$(PICOLIBC_LCS)
# STANDALONE tests run bare-metal in monitor mode, without H2 underneath, so
# they use Picolibc's bare-metal target: semihosting crt0/libsemihost and the
# sysroot's picolibc.ld.  Its default layout is too small for these tests, so
# the regions are set on the link line to match Dinkumware's crt0_standalone.o
# (64MB heap; check_sanity's ~8MB of .data must fit flash and RAM):
#   flash 0x00100000, 8.5MB    RAM 0x01000000, 64MB (heap = the rest, up to the stack)
# Flash and RAM must not overlap.  That crt0 does no CPU setup (MMU/TLB, caches,
# interrupts, cycle counter); the tests that need some of it set it up
# themselves.
STANDALONE_LIBC_CFLAGS := --target=hexagon-none-elf --cstdlib=picolibc
# picolibc.ld for -mv$(TOOLARCH), looked up once per STANDALONE test.  TOOLARCH
# comes from Makefile.inc.tools, which is included before this file.  A missing
# file is reported here, not as a link error.
ifdef STANDALONE
STANDALONE_PICOLIBC_LD := $(shell $(PICOLIBC_CC_PATH) $(STANDALONE_LIBC_CFLAGS) -mv$(TOOLARCH) -G0 -print-file-name=picolibc.ld)
ifeq ($(wildcard $(STANDALONE_PICOLIBC_LD)),)
$(error picolibc.ld not found: '$(STANDALONE_PICOLIBC_LD)' (compiler $(PICOLIBC_CC_PATH), -mv$(TOOLARCH)))
endif
endif
STANDALONE_LIBC_LDFLAGS := $(STANDALONE_LIBC_CFLAGS) -Wl,--defsym=__flash_size=0x00880000 -Wl,--defsym=__ram=0x01000000 -Wl,--defsym=__ram_size=0x04000000 -Wl,-T,$(STANDALONE_PICOLIBC_LD)
else
OSLIB_CFLAGS  :=
OSLIB_LDFLAGS := -moslib=h2
LIBC_LOCKS_LDFLAGS :=
BOOTVM_LOCKS_LDFLAGS :=
GUEST_LDSCRIPT :=
STANDALONE_LIBC_CFLAGS :=
STANDALONE_LIBC_LDFLAGS :=
endif

endif
