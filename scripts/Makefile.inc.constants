# Dear emacs, this is a -*- Makefile -*-

ifndef MAKE_INC_CONSTANTS
MAKE_INC_CONSTANTS := 1

CONSTS := $(INSTALLPATH)/scripts/consts.pl
PARAMS := $(H2K_KERNEL_ADDRBITS) $(H2K_KERNEL_PGSIZE) $(H2K_HEAP_SIZE) $(H2K_STACK_SIZE) $(H2K_ALLOC_HEAP_SIZE) $(H2K_LINK_ADDR) $(H2K_LOAD_ADDR)
KERNEL_TMP := $(INSTALLPATH)/stake/kernel_tmp

# EXEC is set when building a test, which might be linked in kernel space and so
# require more kernel pages
ifndef EXEC
END_SYM_FROM = $(KERNEL_TMP)
else
END_SYM_FROM = $(EXEC)_tmp
endif

# The recipe $(eval)s the constants, so it always runs (FORCE); the stamp is
# rewritten only when a value changes.
CONSTS_STAMP := $(if $(BUILD_DIR),$(BUILD_DIR),.)/consts.stamp

# consts.pl runs hexagon-nm.  GNU make before 4.4 does not pass exported
# variables to $(shell), so the PATH that Makefile.inc.tools prepends
# TOOLCHAIN_BIN to has to be handed over explicitly.  Recursive (=) so PATH is
# read at use time, after Makefile.inc.tools has been included.
CONSTS_RUN = PATH="$(PATH)" $(CONSTS)

.PHONY: constants FORCE
constants: $(CONSTS_STAMP)
FORCE:

$(CONSTS_STAMP): $(END_SYM_FROM) FORCE
	$(eval export H2K_BOOTVM_OFFSET := $(shell $(CONSTS_RUN) bootvm_offset $(END_SYM_FROM) $(PARAMS)))
	$(eval export H2K_BOOTVM_START := $(shell $(CONSTS_RUN) bootvm_start $(END_SYM_FROM) $(PARAMS)))
	$(eval export H2K_V2P_OFFSET := $(shell $(CONSTS_RUN) v2p_offset $(END_SYM_FROM) $(PARAMS)))
	$(eval export H2K_KERNEL_NPAGES = $(shell $(CONSTS_RUN) kernel_npages $(END_SYM_FROM) $(PARAMS)))
	@mkdir -p $(@D)
	@echo "$(H2K_BOOTVM_OFFSET) $(H2K_BOOTVM_START) $(H2K_V2P_OFFSET) $(H2K_KERNEL_NPAGES)" > $@.tmp; \
	cmp -s $@.tmp $@ || mv -f $@.tmp $@; rm -f $@.tmp

endif
