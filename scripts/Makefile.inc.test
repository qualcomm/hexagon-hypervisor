# Dear emacs, this is a -*- Makefile -*-

ifndef MAKE_INC_TEST
MAKE_INC_TEST := 1

################################################################################
#  Test makefile doesn't share above the test dir
################################################################################

#  symbolic link to h2 project directory
#h2: 
#	-ln -s ${H2DIR} $@

################################################################################
#  Tool stuff
################################################################################

default-target: all

# overrides for tests linked in kernel space
H2K_HEAP_SIZE =  0x00010000
H2K_STACK_SIZE = 0x00001000

include $(H2DIR)/scripts/Makefile.inc.config
include $(H2DIR)/scripts/Makefile.inc.opensource
include $(H2DIR)/scripts/Makefile.inc.version
include $(H2DIR)/scripts/Makefile.inc.constants
include $(H2DIR)/scripts/Makefile.inc.tools
include $(H2DIR)/scripts/Makefile.inc.libc

# The flag variables below are accumulated by every makefile that includes this
# one, including the Makefile.coverage driver.  If they arrive from the shell
# environment (e.g. an empty LDFLAGS=), make re-exports the accumulated value to
# each per-test sub-make, which then links with the driver's kernel-space flags
# on top of its own.  Keep them local to each make.
unexport CFLAGS ASFLAGS LDFLAGS

# LDFLAGS must be recursively expanded: it references $(H2K_KERNEL_NPAGES),
# which the 'constants' rule only computes after the test.elf_tmp link.  If
# LDFLAGS is not in the environment, 'unexport' above leaves it defined as an
# empty simple variable, and every 'LDFLAGS +=' below then expands immediately,
# freezing NPAGES at its default of 0.  Re-define it recursively, keeping any
# value passed in from outside.
_LDFLAGS_IN := $(LDFLAGS)
LDFLAGS = $(_LDFLAGS_IN)

ifeq ($(MODEL),)
   MODEL = ref
   MODELSTR = ${MODEL}
else
   ifeq ($(MODEL),ref)
      MODELSTR = ${MODEL}
   else
      MODELSTR = ${MODEL}_v${ARCHV}
   endif
endif

ifeq ($(INSTALLPATH),)
export INSTALLPATH := $(H2DIR)/$(ARTIFACTS_DIR)/v$(ARCHV)/$(MODEL)/install
endif

# T is the build variant (opt or ref).  Exported from the top-level makefile when
# called via 'make opt/ref/cov/test'.  Default to opt if not set (e.g. standalone).
T ?= opt

# Per-ARCHV/variant directory for test build artifacts (not installed, not in-source).
TEST_BUILD_ROOT ?= $(patsubst %/install,%/build/tests,$(INSTALLPATH))

ifeq ($(KERNELPATH),)
export KERNELPATH := $(H2DIR)/kernel
endif


PYTHON=python3

BUSPENALTY=
TIMING=
#Till I figure out something better, here is that file
RUN ?= hexagon-sim

TIMING ?= --timing

BUSPENALTY ?= --buspenalty 50

ULIMIT ?= 600

_BASIC_SIMF=$(TIMING) --simulated_returnval $(BUSPENALTY)

ifeq (hexagon-sim, $(notdir $(firstword ${RUN})))
SIMF=${_BASIC_SIMF}
endif

ifeq (hexagon-sim, $(notdir $(firstword ${RUN})))
SIMF=${_BASIC_SIMF}
endif

################################################################################
#  Rules for building the kernel if necessary; should be built way before any
#  batch jobs are run else they will maul each other in the animal farm.
#
#  Actually, I've broken the dependency between the libs and the executable so 
#  they will never actually try to build the libs; if you need the libs, you 
#  should 'make libs' before you run.
################################################################################

LIBH2_DIR=${INSTALLPATH}/lib
LIBH2=${LIBH2_DIR}/libh2.a

LIBH2KERNEL_DIR=${INSTALLPATH}/lib
LIBH2KERNEL=${LIBH2KERNEL_DIR}/libh2kernel.a
# libh2check.a is now built and installed by kernel ref_install/opt_install.
LIBH2CHECK=${INSTALLPATH}/lib/libh2check.a
ifdef BOOT
BOOTER=${INSTALLPATH}/bin/booter
endif

#  Needs to have the tools already in path...
#SIMPATH=/pkg/qct/software/hexagon/releases/tools/1.2/qc/bin
#TOOLPATH=/pkg/qct/software/hexagon/releases/tools/1.2/gnu/bin
#COVPATH=/pkg/qct/software/hexagon/releases/tools/1.2/examples/utils/bin

${LIBH2KERNEL} ${LIBH2CHECK} ${LIBH2} ${BOOTER} &:
	cd ${H2DIR} && $(MAKE) TARGET=$(TARGET) ARCHV=${ARCHV} build


# $(INSTALLPATH)/ver is written by the build as a version/git-info record.  It is
# not used as a test dependency; the install artifacts themselves are.
$(INSTALLPATH)/ver:
	cd ${H2DIR} && $(MAKE) TARGET=$(TARGET) ARCHV=${ARCHV}


# (_8^(|)  d'oh!
#  Need to tell people to stop using this one and use 'prepare'
libs: ${LIBH2} ${LIBH2CHECK} ${LIBH2KERNEL} ${BOOTER}

prepare: ${LIBH2} ${LIBH2CHECK} ${LIBH2KERNEL} ${BOOTER}

clean_libs:
	cd ${H2DIR};\
	rm -rf $(ARTIFACTS_DIR)/v$(ARCHV)/$(MODEL); $(MAKE) clean

clean_top:
	rm -Rf test.cov_fns cov.txt $(INSTALLPATH)/cov/cov.txt $(INSTALLPATH)/cov/cov.rpt $(INSTALLPATH)/cov/cov_fns $(INSTALLPATH)/cov/cov_files


################################################################################
#  Standard compilation flags
################################################################################

OPTIMIZE := -O1

# For tests are linked in monitor space we don't have __bootvm_entry.  Instead,
# go directly to qdsp6_pre_main (i.e. the old way).  Tests that use booter are
# unaffected by this, because booter has already been built.

# FIXME: Remove H2K_LOAD_ADDR=$(H2K_LINK_ADDR) when tests are no longer in
# monitor space

KERNEL_BUILD_DIR := $(patsubst %/install,%/build/kernel,$(INSTALLPATH))
KERNEL_INCLUDES := -I $(KERNEL_BUILD_DIR)/include -I ${H2DIR}/libs/h2/common

H2K_KERNEL_NPAGES ?= 0

# Kernel-space tests boot straight into the C runtime.  Dinkumware's CRT entry
# points are hexagon_pre_main/qdsp6_pre_main; Picolibc's is _start.
ifeq ($(PICOLIBC),1)
CRT_ENTRY := _start
else
CRT_ENTRY := hexagon_pre_main
CRT_ENTRY_ALT := qdsp6_pre_main
endif

# Image entry: kernel-space images boot through the kernel's reset path
# ('start' in boot.ref.S).  Booter-loaded guests and STANDALONE tests enter the
# C runtime directly; Dinkumware calls that 'start' too, Picolibc only provides
# '_start'.
ifeq ($(PICOLIBC),1)
IMAGE_ENTRY := $(if $(BOOT)$(STANDALONE),_start,start)
else
IMAGE_ENTRY := start
endif

LDFLAGS += -Wl,--defsym=__bootvm_entry_point=$(CRT_ENTRY) -Wl,--defsym=__bootvm_entry=$(or $(CRT_ENTRY_ALT),$(CRT_ENTRY)) -Wl,--defsym=H2K_KERNEL_NPAGES=$(H2K_KERNEL_NPAGES) -Wl,--defsym=H2K_LOAD_ADDR=$(H2K_LINK_ADDR) -Wl,-e=$(IMAGE_ENTRY) # -Wl,--defsym=__entry=$(H2K_LOAD_ADDR)

ifdef BOOT
CFLAGS += $(OPTIMIZE) -mv${TOOLARCH} -DARCHV=${ARCHV} -DH2K_GUEST_START=${H2K_GUEST_START} -Wall -Wno-builtin-requires-header -g
LDFLAGS += -Wl,--section-start=.start=$(H2K_GUEST_START)
else
CFLAGS += $(OPTIMIZE) -mv${TOOLARCH} -DARCHV=${ARCHV} -DH2K_LINK_ADDR=$(H2K_LINK_ADDR) -Wall -Wno-builtin-requires-header -g
ifndef STANDALONE

# Heap size for kernel-space images.  The Picolibc template takes it from
# __heap_size_min and assigns HEAP_SIZE itself.  It also fixes the stack at
# 0x1000, so H2K_STACK_SIZE must stay 0x00001000 when PICOLIBC=1.
ifeq ($(PICOLIBC),1)
KERNEL_HEAP_DEFSYM := -Wl,--defsym=__heap_size_min=$(H2K_HEAP_SIZE)
else
KERNEL_HEAP_DEFSYM := -Wl,--defsym=HEAP_SIZE=$(H2K_HEAP_SIZE)
endif

# 0xfffffff0 means don't call the hook
LDFLAGS += -Wl,--defsym=__h2_handle_errors_hook__=0xfffffff0 -Wl,--defsym=__h2_thread_stop_hook__=0xfffffff0 -Wl,--section-start=.start=$(H2K_LINK_ADDR) $(KERNEL_HEAP_DEFSYM) -Wl,--defsym=STACK_SIZE=$(H2K_STACK_SIZE) -Wl,--defsym=H2K_ALLOC_HEAP_SIZE=$(H2K_ALLOC_HEAP_SIZE)
endif
endif

LINKED_LIBS := ${LIBH2KERNEL} ${LIBH2CHECK}
ifdef STANDALONE
CFLAGS += $(STANDALONE_LIBC_CFLAGS) @${H2DIR}/kernel/build/flags/abi @${H2DIR}/kernel/build/flags/testabi $(KERNEL_INCLUDES) -I ${INSTALLPATH}/include -DH2K_GIT_COMMIT=$(H2K_GIT_COMMIT) -DH2K_ALLOC_HEAP_SIZE=$(H2K_ALLOC_HEAP_SIZE)
LDFLAGS += $(STANDALONE_LIBC_LDFLAGS) -Wl,--defsym=__h2_handle_errors_hook__=0xfffffff0 -Wl,--defsym=__h2_thread_stop_hook__=0xfffffff0 -lh2kernel -lh2 -lh2check -L ${INSTALLPATH}/lib
ASFLAGS += $(STANDALONE_LIBC_CFLAGS) -mv${TOOLARCH} -DARCHV=${ARCHV} -Wall -Wno-builtin-requires-header $(KERNEL_INCLUDES) -I ${INSTALLPATH}/include
ifeq ($(EN_LLVM_COV), 1)
CFLAGS += ${LLVM_COV_CFLAGS}
LDFLAGS += ${LLVM_COV_LDFLAGS}
endif
ifdef LOGBUF
CFLAGS += -DH2K_LOG_PRINTF
_logbuf_one_level := $(subst ],,$(word 2,$(subst [, ,$(LOGBUF))))
ifneq ($(_logbuf_one_level),)
CFLAGS += -DH2K_LOG_LEVEL=$(_logbuf_one_level)
endif
endif

else # non-STANDALONE
OSLIB=$(OSLIB_LDFLAGS)
LINKED_LIBS += ${LIBH2}

ifdef BOOT # use booter
LDFLAGS +=${OSLIB} $(GUEST_LDSCRIPT) -L ${INSTALLPATH}/lib
LINKED_LIBS += ${BOOTER}

else # run in place of booter
LDFLAGS +=${OSLIB} -lh2kernel -lh2 -lh2check -L ${INSTALLPATH}/lib
ifeq ($(PICOLIBC),1)
# Picolibc's crt0 needs the __stack/__bss_*/__tls_*/__heap_* symbols that only
# its linker script provides (the toolchain's H2 Picolibc template, as for
# guests); Dinkumware links these tests without a script.
LDFLAGS += -Wl,--script=$(PICOLIBC_LCS)
endif
endif # BOOT

CFLAGS += $(OSLIB_CFLAGS) -I ${INSTALLPATH}/include
ASFLAGS += $(OSLIB_CFLAGS) -mv${TOOLARCH} -DARCHV=${ARCHV} -Wall -I ${INSTALLPATH}/include
endif #STANDALONE

ifdef SOFT_BKL
CFLAGS  += -DSOFT_BKL
ASFLAGS += -DSOFT_BKL
endif

LDFLAGS+= -mv${TOOLARCH} -Qunused-arguments
#  Turn on call() support for assertion checking
#CFLAGS += -DDEBUG
#  Optimization level needs to match whatever the kernel is compiled with.

ifdef INC_KERNEL
CFLAGS += $(KERNEL_INCLUDES)
ASFLAGS += $(KERNEL_INCLUDES)
endif

ifdef DEBUG
CFLAGS += -DDEBUG
endif

CFLAGS += $(EXTRA_CFLAGS)
ASFLAGS += $(EXTRA_ASFLAGS)

ifdef RECOMPILE_SRCS_PREFS
VPATH += $(RECOMPILE_DIRS)
ifeq ($(BUILD_TYPE),ref)
OBJS += $(foreach m,$(RECOMPILE_SRCS_PREFS),\
  $(if $(wildcard $(addsuffix /$(m).ref.c,$(RECOMPILE_DIRS)) $(addsuffix /$(m).ref.S,$(RECOMPILE_DIRS))),\
    $(m).ref.o,$(m).v$(ARCHV)opt.o))
else
OBJS += $(foreach m,$(RECOMPILE_SRCS_PREFS),\
  $(if $(wildcard $(addsuffix /$(m).v$(ARCHV)opt.S,$(RECOMPILE_DIRS)) $(addsuffix /$(m).v$(ARCHV)opt.c,$(RECOMPILE_DIRS))),\
    $(m).v$(ARCHV)opt.o,$(m).ref.o))
endif
endif

################################################################################
#  Convenience shortcuts
################################################################################

ifdef SUBDIRS

################################################################################
#  Recursive subdirectory traversal
################################################################################

#SUBDIR_MAKE=+for SUBDIR in ${SUBDIRS}; do\
#	$(MAKE) -C $$SUBDIR $(MAKECMDGOALS) TEST=$$SUBDIR; TSTAT=$$?; \
#        if [ $$TSTAT -ne 0 ]; then STAT=$$TSTAT; fi; \
#	done; exit $$STAT

#SUBDIR_TARGETS=clean all

#${SUBDIR_TARGETS}:
#	${SUBDIR_MAKE}

#  Uh...  don't run this unless all the tests are run for now.
# (cov.txt and cov.rpt are now defined in Makefile.coverage as
#  $(INSTALLPATH)/cov.txt and $(INSTALLPATH)/cov.rpt.)

#  every "subdir" needs to have a results.txt in it for this to run properly.
#  if no results.txt, FAIL
#  if results.txt is empty, FAIL
#  
#	      grep -A 1 FAIL $$SUBDIR/test.log >> report.html; \
#	      echo FAIL:  no pass signature >> report.html;\

# Derive variant name (opt/ref) from the install path for the JSON generator.
_VARIANT := $(notdir $(patsubst %/install,%,$(INSTALLPATH)))

# Per-variant parseable test results JSON.  Depends on RESULT_FILES so it is
# only regenerated when a test result actually changes after a new build.
$(INSTALLPATH)/test_results.json: $(RESULT_FILES)
	python3 $(H2DIR)/scripts/gen_test_results.py \
	    --test-build-root $(TEST_BUILD_ROOT) \
	    --subdirs "$(SUBDIRS)" \
	    --archv $(ARCHV) --variant $(_VARIANT) \
	    --output $@

# Write the h2 test report directly into the artifact directory.
# Using $@ avoids the root-level intermediate file that h2_report.html/report.html create,
# so parallel ARCHV builds do not conflict on a shared source-root filename.
# Depends on RESULT_FILES so it is only regenerated when test results change.
$(INSTALLPATH)/test_report.html: $(RESULT_FILES)
	@echo "<html><body><table>" > $@;\
	for SUBDIR in ${SUBDIRS}; do\
	   echo "<tr><td> $$SUBDIR</td>" >> $@;\
	   if [ ! -s $(TEST_BUILD_ROOT)/$$SUBDIR/results.txt ]; then\
	      echo '<td><font style="background-color: red;">' >> $@; \
	      echo 'Missing results.txt, that should not be!' >> $@; \
	      echo '</font></td>' >> $@; \
	   else\
	      grep "TEST PASSED" $(TEST_BUILD_ROOT)/$$SUBDIR/results.txt > /dev/null; \
	      if [ $$? -eq 0 ]; then \
	         echo '<td>' >> $@; \
		 cat $(TEST_BUILD_ROOT)/$$SUBDIR/results.txt >> $@; \
		 echo '</td>' >> $@; \
	      else \
	         echo '<td><font style="background-color: red;">' >> $@; \
		 cat $(TEST_BUILD_ROOT)/$$SUBDIR/results.txt >> $@; \
		 echo '</font></td>' >> $@; \
	      fi; \
	   fi; \
	done;\
	echo "</table></body></html>" >> $@

# Write the qurt test report directly into the artifact directory (same pattern
# as $(INSTALLPATH)/test_report.html above).
$(INSTALLPATH)/qurt_report.html: $(RESULT_FILES)
	@echo "<html><body><table>" > $@;\
	for SUBDIR in ${SUBDIRS}; do\
	   echo "<tr><td> $$SUBDIR</td>" >> $@;\
	   if [ ! -s $(TEST_BUILD_ROOT)/$$SUBDIR/results.txt ]; then\
	      echo '<td><font style="background-color: red;">' >> $@; \
	      echo 'Missing results.txt, that should not be!' >> $@; \
	      echo '</font></td>' >> $@; \
	   else\
	      grep "TEST PASSED" $(TEST_BUILD_ROOT)/$$SUBDIR/results.txt > /dev/null; \
	      if [ $$? -eq 0 ]; then \
	         echo '<td>' >> $@; \
		 cat $(TEST_BUILD_ROOT)/$$SUBDIR/results.txt >> $@; \
		 echo '</td>' >> $@; \
	      else \
	         echo '<td><font style="background-color: red;">' >> $@; \
		 cat $(TEST_BUILD_ROOT)/$$SUBDIR/results.txt >> $@; \
		 echo '</font></td>' >> $@; \
	      fi; \
	   fi; \
	done;\
	echo "</table></body></html>" >> $@

# Recorded failures from the last scan: one "<test> - <reason>" line per failing
# test.  Lives in the per-variant build root so parallel ARCHV/variant runs do
# not share it.
CHECK_FAIL_LIST = $(TEST_BUILD_ROOT)/check_failures.txt

# Shared results scanner used by both 'check' and 'check-fail'.  It walks EVERY
# subdir — a timeout, crash or missing results.txt in one test must never hide
# the results of the remaining tests — printing one verdict line per test plus
# the matching detail lines, and recording each failure in CHECK_FAIL_LIST.  The
# caller decides what to do with the list: 'check' just reports, 'check-fail'
# exits non-zero after the full listing has been printed.
# Every line ends in "; \" so the expansion stays a single shell command.
define SCAN_RESULTS
	mkdir -p $(TEST_BUILD_ROOT); \
	rm -f $(CHECK_FAIL_LIST); \
	touch $(CHECK_FAIL_LIST); \
	NTEST=0; \
	for SUBDIR in ${SUBDIRS}; do \
	   RESULTS=$(TEST_BUILD_ROOT)/$$SUBDIR/results.txt; \
	   NTEST=$$((NTEST+1)); \
	   printf '%s: ' "$$SUBDIR"; \
	   REASON=""; \
	   if [ ! -s $$RESULTS ]; then \
	      REASON="Empty/No results.txt"; \
	   elif grep -q "ERROR" $$RESULTS; then \
	      grep "ERROR" $$RESULTS; \
	      REASON="ERROR detected in results.txt"; \
	   elif grep -q "FAIL" $$RESULTS; then \
	      grep "FAIL" $$RESULTS; \
	      REASON="FAIL detected in results.txt"; \
	   elif grep -q "status 0xaaafa7a1" $$RESULTS; then \
	      grep "status 0xaaafa7a1" $$RESULTS; \
	      REASON="status 0xaaafa7a1 detected in results.txt"; \
	   elif ! grep -q "TEST PASSED" $$RESULTS; then \
	      REASON="No PASS detected in results.txt"; \
	   fi; \
	   if [ -n "$$REASON" ]; then \
	      echo "FAIL - $$REASON"; \
	      echo "$$SUBDIR - $$REASON" >> $(CHECK_FAIL_LIST); \
	   else \
	      grep "TEST PASSED" $$RESULTS; \
	   fi; \
	   echo; \
	done; \
	NFAIL=`wc -l < $(CHECK_FAIL_LIST)`; \
	if [ $$NFAIL -eq 0 ]; then \
	   echo "CHECK v$(ARCHV)/$(TARGET): all $$NTEST tests passed"; \
	else \
	   echo "CHECK v$(ARCHV)/$(TARGET): $$NFAIL of $$NTEST tests FAILED:"; \
	   sed 's/^/    /' $(CHECK_FAIL_LIST); \
	fi
endef

# Report every test, then fail once at the end if anything failed.  The exit
# status is taken from CHECK_FAIL_LIST (a file, not the pipeline) so it survives
# the 'tee' subshell.
check-fail:
	@{ $(SCAN_RESULTS); } 2>&1 | tee -a $(TESTOUT)
	@if [ -s $(CHECK_FAIL_LIST) ]; then exit 1; fi

# Same listing, but always succeeds — for interactive use.
check:
	@{ $(SCAN_RESULTS); } 2>&1


else

DUMP:= $(patsubst %.elf,%.objdump,$(EXEC))
EXEC_TMP := ${EXEC}_tmp

################################################################################
#  These are for actual terminal directories
################################################################################
%.objdump: %.elf
	${OBJDUMP} -d ${@:.objdump=.elf} ${BOOTER} > $@; \
	if [ $$? -ne 0 ]; then echo -e "FAIL ${TEST}\ndisassm fail"|tee test.log; fi

ifdef PYTHON_GENERATOR_SCRIPT
${PYTHON_GENERATED_FILES}: ${PYTHON_GENERATOR_SCRIPT}
	${PYTHON} $<; \
	if [ $$? -ne 0 ]; then echo -e "FAIL ${TEST}\nbuild fail"|tee test.log; fi
endif

%.o: %.c ${PYTHON_GENERATED_FILES}
	${CC} ${CFLAGS} -c -o $@ $<; \
	if [ $$? -ne 0 ]; then echo -e "FAIL ${TEST}\nbuild fail"|tee test.log; fi

%.o: %.S ${PYTHON_GENERATED_FILES}
	${CC} ${ASFLAGS} -c -o $@ $<; \
	if [ $$? -ne 0 ]; then echo -e "FAIL ${TEST}\nbuild fail"|tee test.log; fi

${EXEC_TMP}: ${OBJS} ${LINKED_LIBS}
# How's this for an ugly hack?
	${CC} -o $@ ${OBJS} ${LDFLAGS} 2>&1 | perl -pe 's/.*Symbol.*__h2_.*_hook__.*is defined in both linker script and input file.*//'; \
	CODE=$${PIPESTATUS[0]}; \
	if [ "$$CODE" -ne 0 ]; then echo -e "FAIL ${TEST}\nbuild fail"|tee test.log; fi

${EXEC}: ${EXEC_TMP} | constants
# How's this for an ugly hack?
	${CC} -o $@ ${OBJS} ${LDFLAGS} 2>&1 | perl -pe 's/.*Symbol.*__h2_.*_hook__.*is defined in both linker script and input file.*//'; \
	CODE=$${PIPESTATUS[0]}; \
	if [ "$$CODE" -ne 0 ]; then echo -e "FAIL ${TEST}\nbuild fail"|tee test.log; fi

ignore_fns: ${OBJS}
	${H2DIR}/scripts/gen_ignore_fns.pl ${OBJS} > $@

# ${BOOTER} is empty outside BOOT mode; in BOOT mode the recipe below runs it,
# so re-run when booter changes even if ${EXEC} didn't.
test.log: ${EXEC}
	> $@
ifeq ($(USE_PKW),1)
	echo PKW_VERSIONS $(PKW_VERSIONS) >> $@
	echo PKW_arch $(PKW_arch) >> $@
	echo PKW_hexagon-tools $(PKW_hexagon-tools) >> $@
endif
	ulimit -t ${ULIMIT} && ${RUN} ${SIMF} --profile -- ${BOOTER} ${BOOTER_ARGS} ${EXEC} | tee $@; \
	CODE=$${PIPESTATUS[0]}; \
	echo exit status == $$CODE; \
	if [ "$$CODE" -eq 137 ]; then \
	   echo -e "\nERROR: ${TEST}: probably ulimit" >> $@; \
	fi; \
	if [ "$$QURT_TEST" != "" ]; then \
		if [ "$$CODE" -ne 0 ]; then \
			echo "FAIL" >> $@; \
		else \
			echo "TEST PASSED" >> $@; \
		fi; \
	fi;
	$(POST_RUN)

# Coverage stuff -- single testcase

.PHONY: try_gmon_out

try_gmon_out: test.log
	rm -f gmon.out; \
	find . -maxdepth 1 | egrep -q 'gmon\.t_'; \
	if [ $$? -eq 0 ]; then \
		${GMON_MERGE} -o gmon.out gmon.t_*; \
	else \
		find . -maxdepth 1 | egrep -q 'gmon\-0x'; \
		if [ $$? -eq 0 ]; then \
			${GMON_MERGE} -o gmon.out gmon-0x*; \
		fi; \
	fi

COVFILE=cov.txt
GMON_FILES=gmon.* gmon-*

${COVFILE}: ${DUMP} try_gmon_out ignore_fns
	if [ -f gmon.out ]; then \
		${COV} -F -d ${DUMP} -o cov.txt gmon.out; \
		if [ $$? -ne 0 ]; then echo -e "FAIL ${TEST}\ncoverage fail"; exit 1; fi; \
	else \
		find . -maxdepth 1 -name 'gmon-0x????????.out' | perl -ne 'chomp; $$f = $$_; s/^\.\/gmon-//; s/.out$$//; system("$(COV) -F -d test.objdump -o cov-$$_.txt $$f")'; \
		find . -name 'cov-0x*.txt' | $(PYTHON) ${H2DIR}/scripts/merge_cov.py --dir $(H2DIR) --installpath $(INSTALLPATH) > $@; \
	fi; \
	if [ $$? -ne 0 ]; then echo -e "FAIL ${TEST}\ncoverage fail"; exit 1; fi

CLEANUP=${PYTHON_GENERATED_FILES} ${OBJS} *.ref.o *.v*opt.o ${EXEC} ${EXEC_TMP} ${COVFILE} cov*.txt* ${GMON_FILES} ${DUMP} make.log test.log results.txt h2 threadmap.py
CLEANUP += stats.txt stats_help.txt ihist.txt prof.txt ignore_fns pmu_statsfile.txt pmu_stats.txt default.profraw

clean clean_source:
	rm -rf ${CLEANUP}

#  Pretty much a binary yes/no if the test passed or failed.
results.txt: test.log
	@grep -A 1 "ERROR" test.log > $@; \
	if [ $$? -eq 0 ]; then exit 1; fi; \
	grep -A 1 "FAIL" test.log > $@; \
	if [ $$? -eq 0 ]; then exit 1; fi; \
	grep -A 1 "status 0xaaafa7a1" test.log > $@; \
	if [ $$? -eq 0 ]; then exit 1; fi; \
	grep "TEST PASSED" test.log > $@; \
	if [ $$? -eq 0 ]; then exit 0; fi; \
	if [ ! -s test.log ]; then \
	  echo "FAIL - Test log empty" > $@; \
	  exit 1; \
	fi; \
	echo "NO PASS/FAIL/ERROR in log" > $@; \
	exit 1;

ifdef H2_INSIDE_TOPLEVEL_MAKE
all: results.txt ${COVFILE}
tst: results.txt
test: results.txt
else
all tst test:
	$(MAKE) -C $(H2DIR) ARCHV=$(ARCHV) TARGET=$(TARGET) build
	$(MAKE) H2_INSIDE_TOPLEVEL_MAKE=1 $@
endif
.PHONY: test tst all


endif

endif
